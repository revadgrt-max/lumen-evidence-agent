# Required for LIVE mode (the agent loop). Not needed for the hosted static replay.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — raise rate-limit ceilings. The app works keyless without these.
NCBI_API_KEY=            # PubMed E-utilities: 3 req/s -> 10 req/s   (ncbi.nlm.nih.gov account > Settings)
OPENFDA_API_KEY=         # openFDA: 1,000/day -> 120,000/day         (open.fda.gov/apis/authentication)

# Model for live runs (claude-fable-5 = sharpest; claude-sonnet-5 = cheaper/faster)
LUMEN_MODEL=claude-sonnet-5
PORT=8787
